{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information",
      "Serilog": "Information"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "localhost:3000",
      "admin-truyencv.domain",
      "truyencv.domain"
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "ConnectionStrings_PLACEHOLDER",
    "Enable": true
  },
  "MailEndPoint": "http://localhost:16503/send",
  "Snowflake": {
    "MachineId": 1
  },
  "Firebase": {
    "ProjectId": "kourain-FIREBASE_PROJECT_ID",
    "CredentialsPath": "kourain-FIREBASE_PROJECT_ID-firebase-adminsdk-fbsvc-aaaaaaaa.json",
    "CredentialsBase64": ""
  },
  "JWT": {
    "ValidIssuer": "TruyenCV",
    "ValidAudience": "TruyenCV_USER",
    "SecretKey": "JWT_SECRET_KEY",
    "AccessTokenExpiryMinutes": 5,
    "RefreshTokenExpiryDays": 30
  },
  "Redis": {
    "RedisConnection": "localhost:6379",
    "RedisInstanceName": "TruyenCV"
  },
  "Search": {
    "ComicVector": {
      "Dimensions": 768,
      "MaxResults": 20,
      "MinScore": 0.4,
      "ServiceUrl": "https://pgvector-embed_test.domain/embed",
      "TimeoutSeconds": 15,
      "RetryCount": 2,
      "RetryDelayMilliseconds": 1000
    }
  },
  "Convert2TV": {
    "ServiceUrl": "https://chat-ai.domain/api/chat",
    "TimeoutSeconds": 60
  },
  "TTS": {
    "ServiceUrl": "http://localhost:8000/tts",
    "SoundListUrl": "http://localhost:8000/sounds",
    "TimeoutSeconds": 30
  }
}